{
  "__comment": "Example Grafana dashboard for Komodo Core's /metrics endpoint. Import via Dashboards > New > Import. Every query below targets a metric name that bin/core/src/api/metrics.rs actually emits - see docs/grafana/README.md for the mapping and for what each metric does NOT cover.",
  "title": "Komodo Overview",
  "uid": "komodo-overview",
  "tags": ["komodo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Servers not OK",
      "description": "Anything other than state=\"ok\". Komodo reports counts only, never which server - open Komodo itself to identify one.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(komodo_servers{state!=\"ok\"}) or vector(0)",
          "legendFormat": "not ok",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Servers by state",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "komodo_servers",
          "legendFormat": "{{state}}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Stacks by state",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "komodo_stacks",
          "legendFormat": "{{state}}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Deployments by state",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "komodo_deployments",
          "legendFormat": "{{state}}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stacks and Deployments not running",
      "description": "Trend rather than a point value: a single stack flapping looks identical to a steady outage on a stat panel.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(komodo_stacks{state!=\"running\"}) or vector(0)",
          "legendFormat": "stacks not running"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(komodo_deployments{state!=\"running\"}) or vector(0)",
          "legendFormat": "deployments not running"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Executions in flight, by resource type",
      "description": "A resource pinned above zero for far longer than its executions normally take is the 'something is stuck' signal. Read from the same ActionStates the Komodo UI reads, so the two cannot disagree.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "komodo_executions_in_flight > 0",
          "legendFormat": "{{resource}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Git remotes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Git remote latency (p50 / p95 / p99)",
      "description": "Core's OWN git operations - syncs, stacks, repos and builds reading remote config. Periphery's clones are not included; it accumulates its own and exposes no scrape endpoint. Buckets top out at 60s, so a p99 pinned at 60 means 'at least 60s', not exactly 60.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (operation, le) (rate(komodo_git_remote_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{operation}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(komodo_git_remote_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{operation}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (operation, le) (rate(komodo_git_remote_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{operation}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Git remote failure rate",
      "description": "Failed operations still contribute their duration to the histogram above, so a spike here plus a latency spike there is a timing-out remote rather than a rejected credential.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (operation) (rate(komodo_git_remote_failures_total[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Git operation throughput",
      "description": "Operations per second by kind. A clone where you expected a fetch means the repo folder keeps disappearing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (operation) (rate(komodo_git_remote_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    }
  ]
}
