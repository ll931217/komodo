{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Module resolution */
    "paths": {
      "@/*": [
        "./src/*"
      ],
      /* Resolve the generated client from THIS checkout.
         ui depends on komodo_client through a yarn link, which points
         at whichever checkout ran `make link-client` - so in a git
         worktree the UI would otherwise typecheck against the MAIN
         tree's generated client, and a change that adds a type to the
         client passes here while being broken. */
      "komodo_client": [
        "../client/core/ts/dist/lib.d.ts"
      ],
      "komodo_client/*": [
        "../client/core/ts/dist/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}